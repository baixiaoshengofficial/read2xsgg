# Copy to .env and edit. Docker Compose loads this file automatically.
# cp .env.example .env

ADMIN_TOKEN=change-me
APP_PORT=3000
# IMAGE_TAG=latest
# RESOURCE_LIMIT_PERCENT=90
# CONTAINER_MEMORY_LIMIT=4g
# CONTAINER_MEMORY_SWAP_LIMIT=5g
# CONTAINER_CPUS=5.33
# JOB_ISOLATION=true
# JOB_CONCURRENCY=1
# JOB_VERIFY_BUDGET_MS=0
# JOB_VERIFY_SOURCE_BUDGET_MS=30000
# JOB_VERIFY_WORKERS=8  # 默认按 CPU 并行数；只需在需要限流时显式设置
# VERIFY_WORKERS=8      # 同步 /source 验链 Worker 数
# RETAIN_UNVERIFIED_SOURCES=true  # 结构合法但暂时无法复现完整链路时保留源
# VERIFY_SOURCE_BUDGET_MS=30000
# PREFLIGHT_CONFIRM_TIMEOUT_MS=10000
# PREFLIGHT_SOURCE_BUDGET_MS=30000
# PREFLIGHT_RETRIES=3
# INSECURE_MEDIA_HOSTS=media.example.com
