# Copy to .env and edit. Docker Compose loads this file automatically.
# cp .env.example .env

ADMIN_TOKEN=change-me
APP_PORT=3000
# IMAGE_TAG=latest
# RESOURCE_LIMIT_PERCENT=90
# CONTAINER_MEMORY_LIMIT=4g
# CONTAINER_MEMORY_SWAP_LIMIT=5g
# CONTAINER_CPUS=5.33
# JOB_ISOLATION=true
# JOB_CONCURRENCY=1
# JOB_AUTOSTART=true # 启动时恢复未完成任务；false 时将它们暂停并保留进度
# JOB_VERIFY_BUDGET_MS=0
# JOB_VERIFY_SOURCE_BUDGET_MS=120000
# JOB_VERIFY_RUNTIME_FALLBACK_TIMEOUT_MS=45000 # 单源旧规则候选穷举阶段上限，超限继续通用识站
# JOB_VERIFY_WORKERS=8  # 默认按 CPU 并行数；只需在需要限流时显式设置
# VERIFY_WORKERS=8      # 同步 /source 验链 Worker 数
# VERIFY_REQUEST_TIMEOUT_MS=20000       # 完整验链每个上游请求的超时（不是快速预检超时）
# RETAIN_UNVERIFIED_SOURCES=false # 已弃用：未完成完整链路的源不会发布
# ANALYZE_ATTEMPTS=4              # 识站快速重试轮数；在线转换之后继续退避重试直到通过或单源超时
# ANALYZE_TIMEOUT_MS=30000       # 单次页面识站超时；超出后隔离当前候选
# VERIFY_SOURCE_BUDGET_MS=120000 # 同步转换单源完整验链预算
# VERIFY_RUNTIME_FALLBACK_TIMEOUT_MS=45000 # 旧规则候选穷举阶段上限，超限继续通用识站
# JOB_VERIFY_REQUEST_TIMEOUT_MS=20000   # WebUI 完整验链每个上游请求的超时
# FETCH_RETRIES=2                      # GET/HEAD 遇 5xx/429/连接抖动时的通用重试次数
# BRIDGE_WORKERS=4                     # 桥接 DOM/XPath Worker 数；按 CPU 调整，避免阻塞 HTTP 健康检查
# BRIDGE_EXECUTION_TIMEOUT_MS=12000    # 单次桥接 CPU 解析上限
# PREFLIGHT_CONFIRM_TIMEOUT_MS=20000    # 3 秒快速探活失败后的确认预算
# PREFLIGHT_RETRIES=3
# PREFLIGHT_CANDIDATE_CONCURRENCY=4     # 同一源声明的备选入口探活并发
# INSECURE_MEDIA_HOSTS=media.example.com
